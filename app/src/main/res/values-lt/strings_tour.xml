    <string name="tour_swipe_title">Braukite, kad pakeistumėte skydelį</string>
    <string name="tour_swipe_body">Pagrindinis skydelis yra viduryje. Braukite kairėn arba dešinėn į du šalia esančius. Daugiau skydelių gali būti viršuje ir apačioje.</string>
    <string name="tour_try_swipe">Išbandykite: braukite ekraną</string>
    <string name="tour_arrange_title">Perkelkite ir keiskite plytelių dydį</string>
    <string name="tour_arrange_body">Palieskite plytelę, kad pamatytumėte parinktis, palaikykite, kad perkeltumėte, tempkite kampą, kad pakeistumėte dydį. Palaikius patį skydelį taip pat pradedamas tvarkymas.</string>
    <string name="tour_arrange_hint">Vėliau tai rasite meniu, Redaguoti skydelius.</string>
    <string name="tour_add_title">Pridėkite valdiklį ar programą</string>
    <string name="tour_add_body">Palieskite Pridėti ir įdėkite muziką, auto duomenis, orus ar bet kurią programą į šį skydelį.</string>
    <string name="tour_add_hint">Skubate? Šablonai užpildo visą skydelį iš karto.</string>
    <string name="tour_look_title">Pritaikykite sau</string>
    <string name="tour_look_body">Atidarykite meniu, tada Nustatymai, tada Išvaizda. Pasirinkite temą ir dienos ar nakties spalvas.</string>
    <string name="tour_obd_title">Prijunkite OBD adapterį</string>
    <string name="tour_obd_body">Jis jungiamas į lizdą po vairu. Vieną kartą susiekite jį Android Bluetooth nustatymuose, o toliau Dashwheel prisijungs pats.</string>
    <string name="tour_obd_off">Neprijungtas</string>
    <string name="tour_obd_looking">Ieškoma</string>
    <string name="tour_obd_connected">Prijungtas</string>
    <string name="tour_hands_title">Žiūrėkite į kelią</string>
    <string name="tour_hands_body">Vairo mygtukais galite keisti skydelį, perjungti dainas ar paleisti balso asistentą. Dashwheel pats prabyla, kai kas nors svarbu.</string>
    <string name="tour_hands_hint">Mygtukus nustatykite: Nustatymai, Vairavimas, Vairo mygtukai.</string>
    <string name="tour_wheel_dashboard">Kitas skydelis</string>
