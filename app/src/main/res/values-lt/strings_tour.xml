    <string name="tour_done_title">Viskas paruošta</string>
    <string name="tour_done_body">Šią apžvalgą bet kada vėl rasite: Nustatymai, Bendra, Apie.</string>
    <string name="tour_start_driving">Pradėti važiuoti</string>
    <string name="tour_settings_row">Pagrindų apžvalga</string>
